+
+/*
+ * W5: GLINK over SMEM + QRTR (sweet_glink.c), polled every millisecond for 30 s right after READY.
+ * PASS = IPCRTR open both ways, the modem's QRTR HELLO, and at least one NEW_SERVER. The modem's
+ * fatal bit is checked every 100 ms. WLFW (0x45) is not expected before W6's host services.
+ */
+static void
+rung_w5(void)
+{
+	uint64_t t0 = sweet_modem_ms();
+	uint32_t ms = 0, last_check = 0, state;
+	bool summarized = false;
+
+	if (glink_start() != 0) {
+		return;
+	}
+	while (ms < 30000) {
+		glink_poll(ms);
+		if (ms - last_check >= 100) {
+			last_check = ms;
+			if (sweet_smem_mpss_state(&state) && (state & 1u)) {
+				MLOG("step W5 FAIL: modem signaled fatal at t=%u ms (slave-kernel %#x)", ms, state);
+				glink_summary();
+				return;
+			}
+		}
+		if (!summarized && ms >= 10000) {
+			glink_summary();
+			summarized = true;
+		}
+		sweet_modem_sleep_ms(1);
+		ms = (uint32_t)(sweet_modem_ms() - t0);
+	}
+	glink_summary();
+	if (glink_ready()) {
+		MLOG("step W5 PASS: GLINK IPCRTR up, QRTR HELLO from node %u, services listed", qrtr_modem_node);
+	} else {
+		MLOG("step W5 FAIL: no complete GLINK/QRTR handshake in 30 s (see summary)");
+	}
 }
 
 /* PIL service and argument descriptors follow the Qualcomm SCM PAS ABI. */
@@ -360,7 +401,9 @@ rung_w3(void)
 			status = sweet_modem_scm(SCM_FN(2, 5), 1, MODEM_PAS_ID, 0, 0, 0, &result);
 			MLOG("step W4 auth_and_reset: transport %#llx result %#llx", status, result);
 			if (!status && !result) {
-				modem_wait_ready();
+				if (modem_wait_ready() && sweet_modem_level >= 5) {
+					rung_w5();
+				}
 				goto release;
 			}
 		}
