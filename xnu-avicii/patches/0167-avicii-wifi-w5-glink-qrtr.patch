+static void
+ipcc_kick(uint32_t client, uint32_t signal)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	smem_wr32(ipcc, IPCC_REG_SEND_ID, (client << 16) | signal);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* sweet_modem.h interface for sweet_glink.c (W5) */
+void *
+mipc_smem_get(uint16_t item, uint32_t *size)
+{
+	uint32_t data = mpss_part ? smem_mpss_find(item, size) : 0;
+	return data ? (void *)(uintptr_t)(mpss_part + data) : NULL;
+}
+
+void *
+mipc_smem_alloc(uint16_t item, uint32_t size)
+{
+	bool existed;
+	uint32_t data = smem_mpss_alloc(item, size, &existed);
+	return data ? (void *)(uintptr_t)(mpss_part + data) : NULL;
+}
