-			smem_wr16(part, free_uncached + 8, (uint16_t)(aligned - SMP2P_ITEM_SIZE));
+			smem_wr16(part, free_uncached + 8, (uint16_t)(aligned - size));
 			smem_wr16(part, free_uncached + 10, 0);
 			smem_wr32(part, free_uncached + 12, 0);
 			for (uint32_t o = 0; o < aligned; o += 4) {
@@ -384,17 +399,63 @@ sweet_smem_mpss_smp2p_out(void)
 			smem_wr32(part, 12, free_uncached + need);
 			ok = true;
 		} else {
-			printf("SWEET SMEM: smp2p out: no room (free %#x..%#x need %#x) or item raced in\n",
