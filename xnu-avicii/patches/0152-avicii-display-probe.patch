+/*
+ * Read-only: what the apps_smmu says about one stream ID (patch 0152, D1 display probe). No register is
+ * written. Logs every SMR whose ID/mask matches `sid` with its S2CR (type 0 translate, 1 bypass,
+ * 2 fault; CBNDX) and, for a translating S2CR, the context bank's SCTLR/TTBR0/TCR/MAIR0/FSR. Layout
+ * as sweet_smmu_map_sid() above and refs/marnov999-raphael-ios-gpu 0120 (SMR [14:0] id, [30:16]
+ * mask, [31] valid; S2CR [17:16] type, [7:0] cbndx).
+ */
+void sweet_smmu_probe_sid(unsigned sid);
+void
+sweet_smmu_probe_sid(unsigned sid)
+{
+	vm_offset_t g0 = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (!g0) {
+		printf("SWEET MDP: smmu map failed\n");
+		return;
+	}
+	uint32_t id0 = rd(g0, 0x20), id1 = rd(g0, 0x24);
+	unsigned pgs = (id1 >> 31) ? 16 : 12, ncb = id1 & 0xff, nsm = id0 & 0xff, hits = 0;
+	vm_offset_t cbs = g0 + ((vm_offset_t)(1u << (((id1 >> 28) & 7) + 1)) << pgs);
+	printf("SWEET MDP: smmu cr0 %#x id0 %#x id1 %#x (%u smr, %u cb, pgshift %u)\n", rd(g0, 0), id0, id1, nsm, ncb, pgs);
+	for (unsigned i = 0; i < nsm && i < 128; i++) {
+		uint32_t smr = rd(g0, 0x800 + 4 * i), s2cr = rd(g0, 0xc00 + 4 * i);
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		if (!(smr & (1u << 31)) || ((sid ^ id) & ~mask) != 0) {
+			continue;
+		}
+		hits++;
+		unsigned type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		printf("SWEET MDP: smmu sid %#x: smr %u %#x (id %#x mask %#x) s2cr %#x type %u (%s) cbndx %u\n", sid, i, smr, id, mask,
+		    s2cr, type, type == 0 ? "translate" : type == 1 ? "bypass" : type == 2 ? "fault" : "?", cb);
+		if (type == 0 && cb < ncb) {
+			vm_offset_t c = cbs + ((vm_offset_t)cb << pgs);
+			printf("SWEET MDP: smmu cb %u: sctlr %#x ttbr0 %#llx tcr %#x mair0 %#x fsr %#x cbar %#x\n", cb, rd(c, 0x0),
+			    (unsigned long long)(*(volatile uint64_t *)(c + 0x20)), rd(c, 0x30), rd(c, 0x38), rd(c, 0x58),
+			    rd(g0 + (1u << pgs), 4 * cb));
+		}
+	}
+	if (hits == 0) {
+		printf("SWEET MDP: smmu sid %#x: no valid SMR matches\n", sid);
+	}
+}
