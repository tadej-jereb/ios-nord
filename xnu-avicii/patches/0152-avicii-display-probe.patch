+/*
+ * 0152 (D1): the physical layout of a surface iOS swaps in: first PA, whether every page follows the
+ * last, and how many discontinuities there are (decides the zero-copy buffer design, D3). Logged once per
+ * surface id (at most SWEET_FB_SEEN_MAX). Reads only. Not under fLock.
+ */
+void
+AppleCLCD::surfaceWalk(SweetSurface *s, uint32_t layer)
+{
+	uint32_t n;
+	for (n = 0; n < fSeenN; n++) {
+		if (fSeen[n] == s->id) {
+			return;
+		}
+	}
+	if (fSeenN >= SWEET_FB_SEEN_MAX) {
+		return;
+	}
+	fSeen[fSeenN++] = s->id;
+	if (s->memory == NULL) {
+		IOLog("SWEET MDP: surface %u layer %u: no memory descriptor\n", s->id, layer);
+		return;
+	}
+	IOByteCount off = s->wrapped ? s->wrapDelta : 0, end = off + s->allocSize;
+	uint64_t first = 0, prev_end = 0, maxseg = 0;
+	uint32_t segs = 0, breaks = 0, iter = 0;
+	while (off < end && iter++ < 16384) {
+		IOByteCount len = 0;
+		addr64_t p = s->memory->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		if (p == 0 || len == 0) {
+			break;
+		}
+		if (len > end - off) {
+			len = end - off;
+		}
+		if (segs == 0) {
+			first = p;
+		} else if (p != prev_end) {
+			breaks++;
+		}
+		if (segs < 4) {
+			IOLog("SWEET MDP: surface %u seg %u pa 0x%llx len 0x%llx\n", s->id, segs, (uint64_t)p, (uint64_t)len);
+		}
+		if (len > maxseg) {
+			maxseg = len;
+		}
+		prev_end = (uint64_t)p + len;
+		segs++;
+		off += len;
+	}
+	IOLog("SWEET MDP: surface %u layer %u %ux%u bpr %u size %u wrapped %d: first pa 0x%llx end 0x%llx, "
+	    "%u segments, %u discontinuities, max segment 0x%llx, %s%s%s (walked %llu of %u bytes)\n",
+	    s->id, layer, s->width, s->height, s->bytesPerRow, s->allocSize, s->wrapped ? 1 : 0,
+	    first, prev_end, segs, breaks, maxseg, breaks == 0 && segs != 0 ? "CONTIGUOUS" : "NOT contiguous",
+	    first > 0xffffffffull ? ", first pa above 4 GiB" : ", first pa below 4 GiB",
+	    prev_end > 0x100000000ull ? ", end above 4 GiB" : "",
+	    (uint64_t)(off - (s->wrapped ? s->wrapDelta : 0)), s->allocSize);
+}
+
+/*
+ * 0152 (D1): read-only probe of the display engine's state. No register is written (MDP, DSI or SMMU).
+ * Run once at start and once SWEET_MDP_PROBE2_S s later (after iOS is presenting).
+ */
+void
+AppleCLCD::mdpProbe(const char *when)
+{
+	if (fMdp == 0) {
+		fMdp = ml_io_map(SWEET_MDP_PA, SWEET_MDP_SIZE);
+	}
+	if (fMdp == 0) {
+		IOLog("SWEET MDP: map failed\n");
+		return;
+	}
+	IOLog("SWEET MDP: probe (%s): mdp 0x%x size 0x%x, boot fb pa 0x%llx %ux%u stride %u\n", when,
+	    SWEET_MDP_PA, SWEET_MDP_SIZE, fPhys, fWidth, fHeight, fRowBytes);
+	for (uint32_t i = 0; i < sizeof(sweet_mdp_sspp) / sizeof(sweet_mdp_sspp[0]); i++) {
+		vm_offset_t p = fMdp + sweet_mdp_sspp[i].off;
+		uint32_t src = mdp_rd(p, 0x14);
+		IOLog("SWEET MDP: %s src_size 0x%08x img_size 0x%08x src_xy 0x%08x out_size 0x%08x out_xy 0x%08x "
+		    "src0_addr 0x%08x ystride0 0x%08x fmt 0x%08x op 0x%08x%s\n", sweet_mdp_sspp[i].name,
+		    mdp_rd(p, 0x00), mdp_rd(p, 0x04), mdp_rd(p, 0x08), mdp_rd(p, 0x0c), mdp_rd(p, 0x10), src,
+		    mdp_rd(p, 0x24), mdp_rd(p, 0x30), mdp_rd(p, 0x38),
+		    src == (uint32_t)fPhys ? "  <- boot framebuffer" : "");
+		if (sweet_mdp_sspp[i].vig) {
+			vm_offset_t q = p + SWEET_MDP_QSEED;
+			IOLog("SWEET MDP: %s qseed3 ver 0x%08x op 0x%08x src_size 0x%08x dst_size 0x%08x phase_step y_h 0x%08x y_v 0x%08x\n",
+			    sweet_mdp_sspp[i].name, mdp_rd(q, 0x00), mdp_rd(q, 0x04), mdp_rd(q, 0x40), mdp_rd(q, 0x48),
+			    mdp_rd(q, 0x10), mdp_rd(q, 0x14));
+		}
+	}
+	vm_offset_t ctl = fMdp + SWEET_MDP_CTL0;
+	IOLog("SWEET MDP: CTL0 layer LM0..3 0x%08x 0x%08x 0x%08x 0x%08x ext LM0 0x%08x ext2 LM0 0x%08x ext3 LM0 0x%08x\n",
+	    mdp_rd(ctl, 0x00), mdp_rd(ctl, 0x04), mdp_rd(ctl, 0x08), mdp_rd(ctl, 0x0c),
+	    mdp_rd(ctl, 0x40), mdp_rd(ctl, 0x70), mdp_rd(ctl, 0xa0));
+	IOLog("SWEET MDP: CTL0 top 0x%08x flush 0x%08x start 0x%08x status 0x%08x intf_active 0x%08x intf_flush 0x%08x; "
+	    "LM0 out_size 0x%08x +8 0x%08x\n",
+	    mdp_rd(ctl, 0x14), mdp_rd(ctl, 0x18), mdp_rd(ctl, 0x1c), mdp_rd(ctl, 0x64), mdp_rd(ctl, 0xf4),
+	    mdp_rd(ctl, 0x110), mdp_rd(fMdp + SWEET_MDP_LM0, 0x04), mdp_rd(fMdp + SWEET_MDP_LM0, 0x08));
+	vm_offset_t it = fMdp + SWEET_MDP_INTF1;
+	uint32_t f0 = mdp_rd(it, 0xac);
+	IODelay(50000);
+	uint32_t f1 = mdp_rd(it, 0xac);
+	IOLog("SWEET MDP: INTF1 timing_en 0x%08x config 0x%08x config2 0x%08x panel_fmt 0x%08x cmd_trigger_en 0x%08x "
+	    "frame_line_count_en 0x%08x frame_count %u -> %u in 50 ms line_count 0x%08x\n",
+	    mdp_rd(it, 0x00), mdp_rd(it, 0x04), mdp_rd(it, 0x60), mdp_rd(it, 0x90), mdp_rd(it, 0x84),
+	    mdp_rd(it, 0xa8), f0, f1, mdp_rd(it, 0xb0));
+	IOLog("SWEET MDP: INTF1 tear mdp_vsync_sel 0x%08x tear_check_en 0x%08x sync_config_vsync 0x%08x sync_height 0x%08x "
+	    "wrcount 0x%08x vsync_init 0x%08x int_count 0x%08x\n",
+	    mdp_rd(it, 0x280), mdp_rd(it, 0x284), mdp_rd(it, 0x288), mdp_rd(it, 0x28c),
+	    mdp_rd(it, 0x290), mdp_rd(it, 0x294), mdp_rd(it, 0x298));
+	IOLog("SWEET MDP: INTF1 tear sync_thresh 0x%08x start_pos 0x%08x rd_ptr_irq 0x%08x wr_ptr_irq 0x%08x "
+	    "out_line_count 0x%08x line_count 0x%08x autorefresh_cfg 0x%08x (enable bit31, frames [15:0])\n",
+	    mdp_rd(it, 0x29c), mdp_rd(it, 0x2a0), mdp_rd(it, 0x2a4), mdp_rd(it, 0x2a8),
+	    mdp_rd(it, 0x2ac), mdp_rd(it, 0x2b0), mdp_rd(it, 0x2b4));
+	/* The surface iOS is swapping in right now, if it has swapped */
+	uint8_t rec[SWEET_FB_SWAP_REC_SIZE];
+	bool have;
+	IOLockLock(fLock);
+	have = fPendingID != 0;
+	if (have) {
+		memcpy(rec, fPending, sizeof(rec));
+	}
+	IOLockUnlock(fLock);
+	if (have) {
+		for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+			uint32_t id = get32(rec, 0x54 + 4 * layer);
+			SweetSurface *s = id != 0 ? sweet_surface_copy(id) : NULL;
+			if (s != NULL && s != fSurface) {
+				fSeenN = 0;     /* force the walk to print again at each probe */
+				surfaceWalk(s, layer);
+			}
+			OSSafeReleaseNULL(s);
+		}
+	} else {
+		IOLog("SWEET MDP: no swap yet (%s)\n", when);
+	}
+	sweet_smmu_probe_sid(SWEET_MDP_SID);
+}
