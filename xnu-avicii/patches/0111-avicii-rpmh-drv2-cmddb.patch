+/*
+ * avicii live FDT (logs/dumps/run-20261112-195027/10-fdt.dtb):
+ *   rsc@18200000  reg = drv-0 0x18200000, drv-1 0x18210000, drv-2 0x18220000
+ *                 (0x10000 each), qcom,drv-id = 2, qcom,tcs-offset = 0xd00
+ *   reserved-memory@80860000  compatible "qcom,cmd-db", 0x20000, the database
+ *                 itself (not a locator as on sweet)
+ * The sweet values (one RSC window at 0x18200000) addressed DRV0, which HLOS
+ * does not own: the first TCS access reset the SoC (2026-11-14).
+ */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
 #define RH_TCS_SIZE     0x3000u
 #define RH_DICT_PA      0x80860000u /* live FDT qcom,cmd-db */
+#define RH_DICT_SIZE    0x20000u
 #define RH_DRV          2u
 #define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
 #define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
