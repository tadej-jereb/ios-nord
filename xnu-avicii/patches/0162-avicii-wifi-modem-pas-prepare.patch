diff --git a/bsd/dev/sweet_modem.c b/bsd/dev/sweet_modem.c
index 0acb427..81f7073 100644
--- a/bsd/dev/sweet_modem.c
+++ b/bsd/dev/sweet_modem.c
@@ -78,6 +78,7 @@ sweet_modem_alloc_contig(size_t size, uint64_t *pa)
 	}
 	pn = pmap_find_phys(kernel_pmap, (addr64_t)va);
 	if (!pn) {
+		kmem_free(kernel_map, va, size);
 		return NULL;
 	}
 	*pa = ((uint64_t)pn << PAGE_SHIFT);
@@ -212,6 +213,61 @@ rung_w2(void)
 	return true;
 }
 
+extern bool sweet_smem_mpss_empty(void);
+
+/* PIL service and argument descriptors follow the Qualcomm SCM PAS ABI. */
+static void
+rung_w3(void)
+{
+	uint64_t result, status, pa;
+	uint32_t length = mdt.hdr_size + mdt.hash_size;
+	struct mfw_file hash;
+
+	status = sweet_modem_scm(SCM_FN(2, 7), 1, MODEM_PAS_ID, 0, 0, 0, &result);
+	MLOG("step W3 supported: transport %#llx result %#llx", status, result);
+	if (status || result != 1 || !sweet_smem_mpss_empty()) {
+		MLOG("step W3 stop: PAS unsupported or MPSS partition not empty");
+		return;
+	}
+	uint8_t *meta = sweet_modem_alloc_contig(length, &pa);
+	if (!meta) {
+		MLOG("step W3 stop: allocating metadata failed");
+		return;
+	}
+	memcpy(meta, mdt.raw, mdt.hdr_size);
+	if (mdt.hash_in_mdt) {
+		memcpy(meta + mdt.hdr_size, mdt.raw + mdt.hash_off, mdt.hash_size);
+	} else if (mdt_open_seg(mdt.hash_index, &hash) ||
+	    mfw_read(&hash, 0, meta + mdt.hdr_size, mdt.hash_size)) {
+		MLOG("step W3 stop: reading hash failed");
+		goto release;
+	}
+	sweet_modem_to_memory(meta, length);
+	MLOG("step W3 init_image: submitting %u bytes of signed metadata", length);
+	status = sweet_modem_scm(SCM_FN(2, 1), 0x82, MODEM_PAS_ID, pa, 0, 0, &result);
+	MLOG("step W3 init_image: transport %#llx result %#llx", status, result);
+	if (status || result) {
+		goto release;
+	}
+	if (mdt.relocatable) {
+		status = sweet_modem_scm(SCM_FN(2, 2), 3, MODEM_PAS_ID, MODEM_REGION_PA,
+		    round_page_64((uint64_t)mdt.max_addr - mdt.min_addr), 0, &result);
+		MLOG("step W3 mem_setup: transport %#llx result %#llx", status, result);
+	}
+	bool prepared = status == 0 && result == 0;
+	status = sweet_modem_scm(SCM_FN(2, 6), 1, MODEM_PAS_ID, 0, 0, 0, &result);
+	MLOG("step W3 shutdown: transport %#llx result %#llx", status, result);
+	if (status || result) {
+		MLOG("step W3 stop: holding metadata until reboot");
+		return;
+	}
+	if (prepared) {
+		MLOG("step W3 PASS: signed modem metadata accepted");
+	}
+release:
+	kmem_free(kernel_map, (vm_offset_t)meta, round_page(length));
+}
+
 /* ---------------------------------------------------------------- thread */
 
 static void
@@ -240,8 +296,8 @@ sweet_modem_thread(__unused void *arg, __unused wait_result_t wr)
 		goto out;
 	}
 	MLOG("step W2 PASS: firmware readable and inside the carve-out; no hardware was touched");
-	if (sweet_modem_level < 3) {
-		goto out;
+	if (sweet_modem_level >= 3) {
+		rung_w3();
 	}
 out:
 	mdt_free(&mdt);
