 	}
+	/* Nothing else ever flushes the device cache for the file system. */
+	if (!rd && su.syncwrites && !error) {
+		error = ufs_sync_cache();
+	}
+	su_fua_bp = false;
 	lck_mtx_unlock(&sweet_ufs_lock);
 	buf_unmap(bp);
 
