+	/*
+	 * FUA makes the device commit before the status, which is the only ordering a
+	 * journal commit gets here: nothing in this tree sets B_FUA on its own (there
+	 * is no DK_FEATURE_FUA), so the boot-arg is the opt-in and B_FUA an extra.
+	 */
+	uint8_t fua = su.fua || su_fua_bp;
 	uint8_t cdb[10] = {
-		0x2a, 0,
+		0x2a, fua ? 0x08 : 0,              /* byte 1 bit 3: FUA, write through the device cache */
 		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
 		0, (uint8_t)(count >> 8), (uint8_t)count, 0
 	};
@@ -556,6 +565,7 @@
 				memcpy(vaddr + done, (const char *)bounce + skip, want);
 			}
 		} else {
+			su_fua_bp = (buf_flags(bp) & B_FUA) != 0;
 			/* Partial device blocks at either end: read, merge, write back. */
 			if (skip || (want % UFS_BLOCK)) {
 				error = ufs_read_blocks(su.first_block + lba, blocks);
@@ -571,6 +581,11 @@
 		done += want;
