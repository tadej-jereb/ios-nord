diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 7ec2c24..bedd91b 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -27,6 +27,7 @@
 #include <sys/errno.h>
 #include <sys/proc.h>
 #include <sys/uio.h>
+#include <sys/sysctl.h>
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
 #include <kern/clock.h>
@@ -895,6 +896,90 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
+/*
+ * 0142: read the logs from iOS over SSH, without recovery adb.
+ *   sysctl -b kern.sweetlog       this boot's console ring, oldest byte first
+ *   sysctl -b kern.sweetlog_prev  the previous boot's ring as it was on disk
+ *                                 (loaded once at boot, before the log thread
+ *                                 overwrites it; empty if no valid header)
+ * Raw reads of /dev/rufsroot0 near the partition end hung the kernel
+ * (2026-11-16 21:45Z, watchdog -> fastboot), so this goes through the driver.
+ */
+static char sweet_log_prev[SWEET_LOG_SIZE];
+static uint32_t sweet_log_prev_len;
+
+static void
+sweet_log_prev_load(void)
+{
+	uint64_t base = su.first_block + su.nblocks - SWEET_LOG_BLOCKS;
+	const char *bounce = (const char *)(su.dma + DMA_BOUNCE);
+	struct sweet_log_header h = {};
+	int error;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(base, 1);
+	if (!error) {
+		memcpy(&h, bounce, sizeof(h));
+	}
+	if (error || memcmp(h.magic, "SWEETLOG", 8) != 0 || h.version != 1 ||
+	    h.size != SWEET_LOG_SIZE || h.total == 0) {
+		lck_mtx_unlock(&sweet_ufs_lock);
+		printf("SWEET LOG: previous boot: no log (read %d)\n", error);
+		return;
+	}
+	/* Byte at ring offset o is console byte (o - start) mod size; copy each
+	 * block straight to its place (no second 4 MiB buffer). */
+	uint64_t len = MIN(h.total, (uint64_t)SWEET_LOG_SIZE);
+	uint32_t start = (uint32_t)((h.total - len) % SWEET_LOG_SIZE);
+	for (uint32_t blk = 0; blk < SWEET_LOG_SIZE / UFS_BLOCK && !error;) {
+		uint32_t n = MIN(SWEET_LOG_SIZE / UFS_BLOCK - blk, BOUNCE_SIZE / UFS_BLOCK);
+		error = ufs_read_blocks(base + 1 + blk, n);
+		for (uint32_t i = 0; !error && i < n * UFS_BLOCK; i++) {
+			uint32_t o = blk * UFS_BLOCK + i;
+			uint32_t at = (o + SWEET_LOG_SIZE - start) % SWEET_LOG_SIZE;
+			if (at < len) {
+				sweet_log_prev[at] = bounce[i];
+			}
+		}
+		blk += n;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error) {
+		printf("SWEET LOG: previous boot: ring read failed %d\n", error);
+		return;
+	}
+	sweet_log_prev_len = (uint32_t)len;
+	printf("SWEET LOG: previous boot: %u bytes, total %llu, flush seq %#llx%s\n",
+	    sweet_log_prev_len, h.total, h.seq,
+	    h.seq == 0xffffffffu ? " (written at reset/panic)" : "");
+}
+
+static int
+sysctl_sweetlog_prev SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	return SYSCTL_OUT(req, sweet_log_prev, sweet_log_prev_len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweetlog_prev, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweetlog_prev, "S", "previous boot's console log (0142)");
+
+static int
+sysctl_sweetlog SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t len = MIN(total, (uint64_t)SWEET_LOG_SIZE);
+	uint32_t off = (uint32_t)((total - len) % SWEET_LOG_SIZE);
+	uint32_t first = (uint32_t)MIN(len, (uint64_t)(SWEET_LOG_SIZE - off));
+	int error = SYSCTL_OUT(req, sweet_log_ring + off, first);
+	if (!error && len > first) {
+		error = SYSCTL_OUT(req, sweet_log_ring, (size_t)(len - first));
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweetlog, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweetlog, "S", "this boot's console log (0142)");
+
 static void
 sweet_log_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -1006,6 +1091,7 @@ sweet_log_start(void)
 	if (!on || !su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
 		return;
 	}
+	sweet_log_prev_load();  /* 0142: before the log thread's first flush */
 	PE_parse_boot_argn("ufslogsecs", &sweet_log_secs, sizeof(sweet_log_secs));
 	if (sweet_log_secs == 0 || sweet_log_secs > 60) {
 		sweet_log_secs = SWEET_LOG_SECS;
diff --git a/osfmk/arm64/sweet_reset.c b/osfmk/arm64/sweet_reset.c
