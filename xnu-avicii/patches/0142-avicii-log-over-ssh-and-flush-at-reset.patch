 static vm_offset_t sweet_imem_va;
 static vm_offset_t sweet_pshold_va;
 static uint32_t sweet_armfb = 1;
+static uint32_t sweet_log_flush = 1;  /* 0142: boot-arg sweetlogflush */
 static vm_offset_t sweet_spmi_core, sweet_spmi_cfg, sweet_spmi_obs, sweet_pon_ch;
 static uint32_t sweet_pon_apid = 0xffffu;
 
@@ -207,6 +208,7 @@ sweet_reset_startup(void)
 		return;
 	}
 	(void)PE_parse_boot_argn("sweetarmfb", &sweet_armfb, sizeof(sweet_armfb));
+	(void)PE_parse_boot_argn("sweetlogflush", &sweet_log_flush, sizeof(sweet_log_flush)); /* 0142 */
 	{
 		uint8_t sub = 0, old = 0;
 		if (sweet_pon_find() != 0 || sweet_pon_rd(SWEET_PON_SUBTYPE, &sub) != 0) {
@@ -246,6 +248,19 @@ sweet_reset(const char *why)
 		printf("SWEET RESET: %s -> %s (PON %#x -> %#x)\n", why,
 		    sweet_reset_mode_name(sweet_reset_mode), old, rb);
 	}
+	{
+		/*
+		 * 0142: write the console log to disk before every deliberate
+		 * reset. A panic resets through PEHaltRestart -> halt_all_cpus ->
+		 * here, before debug.c's own sweet_log_panic_flush() is reached
+		 * (0139 test 2026-11-16: ring ended at a periodic flush, no panic
+		 * text). Boot-arg sweetlogflush=0 skips it.
+		 */
+		if (sweet_log_flush) {
+			extern void sweet_log_panic_flush(void);
+			sweet_log_panic_flush();
+		}
+	}
 	if (sweet_imem_va != 0 && sweet_reset_mode != 3) {
 		*(volatile uint32_t *)(sweet_imem_va + SWEET_IMEM_RR_OFF) =
 		    sweet_reset_mode == 2 ? SWEET_RR_RECOVERY : SWEET_RR_BOOTLOADER;
