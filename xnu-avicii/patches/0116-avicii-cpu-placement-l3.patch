+/* Map one domain and read its table; dom[d].top is the fastest row with the
+ * domain's full core count (L3 rows carry no core count, so all qualify). */
+static void
+osm_probe(unsigned d)
+{
+	vm_offset_t b = ml_io_map(osm_domain_pa[d], OSM_DOM_SIZE);
+	unsigned n = 0, maxc = 0, top = 0;
+
+	if (!b) {
+		printf("SWEET CPUFREQ: domain %u map failed\n", d);
+		return;
+	}
+	dom[d].base = b;
+	uint32_t en = osm_rd(b, OSM_ENABLE);
+	if (!(en & 1u)) {
+		printf("SWEET CPUFREQ: domain %u (%s) not enabled (0x%x), left alone\n",
+		    d, osm_domain_name[d], en);
+		return;
+	}
+	for (unsigned i = 0; i < OSM_LUT_MAX; i++) {
+		dom[d].rows[i] = osm_rd(b, OSM_FREQ_LUT + i * OSM_LUT_ROW);
+		n = i + 1;
+		if (osm_cores(dom[d].rows[i]) > maxc) {
+			maxc = osm_cores(dom[d].rows[i]);
+		}
+		if (i > 0 && osm_mhz(dom[d].rows[i]) == osm_mhz(dom[d].rows[i - 1]) &&
+		    osm_cores(dom[d].rows[i]) == osm_cores(dom[d].rows[i - 1])) {
+			n = i;  /* repeated row ends the table and is not a level */
+			break;
+		}
+	}
+	for (unsigned i = 0; i < n; i++) {
+		if (osm_cores(dom[d].rows[i]) == maxc && osm_mhz(dom[d].rows[i]) > osm_mhz(dom[d].rows[top])) {
+			top = i;
+		}
+	}
+	dom[d].n = n;
+	dom[d].top = top;
+	dom[d].enabled = 1;
+}
