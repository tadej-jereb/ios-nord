+/*
+ * avicii: the ADT declares all eight cores as one SMP cluster, so backboardd's
+ * render thread (one thread at ~95% of a core during a scroll, logs/phone/
+ * bbd-threads-20261115.txt) lands on the A55s as often as on the A76s. Bind the
+ * thread that presents frames to an A76 (boot-arg sweetbind=CPU, default 7 =
+ * the prime A76; -1 disables). At most four distinct threads are bound, so a
+ * presenter that hops between worker threads cannot pile them all onto one core.
+ */
+extern "C" kern_return_t sweet_bind_self(int cpu);
+extern "C" uint64_t thread_tid(thread_t);
+static int32_t sweet_fb_bind_cpu = -2;
+static thread_t sweet_fb_bound[4];
+
+static void
+sweet_fb_bind_presenter(void)
+{
+	thread_t self = current_thread();
+	unsigned i;
+
+	if (sweet_fb_bind_cpu == -2) {
+		int32_t v = 7;
+		PE_parse_boot_argn("sweetbind", &v, sizeof(v));
+		sweet_fb_bind_cpu = v;
+	}
+	if (sweet_fb_bind_cpu < 0) {
+		return;
+	}
+	for (i = 0; i < 4 && sweet_fb_bound[i] != THREAD_NULL; i++) {
+		if (sweet_fb_bound[i] == self) {
+			return;
+		}
+	}
+	if (i == 4) {
+		return;
+	}
+	kern_return_t kr = sweet_bind_self(sweet_fb_bind_cpu);
+	sweet_fb_bound[i] = self;       /* also on failure: try each thread once */
+	IOLog("SWEET FB: presenting thread %llu (#%u) bound to cpu %d: kr %d\n",
+	    thread_tid(self), i, sweet_fb_bind_cpu, kr);
+}
