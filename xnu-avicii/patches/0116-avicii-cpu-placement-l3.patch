+/*
+ * SWEET (avicii) thread placement. The ADT declares the 2x A76 + 6x A55 as one
+ * SMP cluster (hw.nperflevels 1), so the scheduler cannot tell the fast cores
+ * from the slow ones. These let the framebuffer bind backboardd's presenting
+ * thread to an A76 and let kern.sweet_bind (bsd/dev/sweet_cpufreq.c) list or
+ * bind any task's threads. Realtime threads are refused: thread_bind_internal
+ * asserts sched_pri < BASEPRI_RTQUEUES.
+ */
+kern_return_t sweet_bind_self(int cpu);
+kern_return_t sweet_task_threads(task_t task, int idx, int cpu, char *out, size_t outlen);
+
+static kern_return_t
+sweet_cpu_processor(int cpu, processor_t *out)
+{
+	*out = PROCESSOR_NULL;
+	if (cpu < 0) {
+		return KERN_SUCCESS;            /* unbind */
+	}
+	if (cpu > ml_get_max_cpu_number() || (*out = cpu_to_processor(cpu)) == PROCESSOR_NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+sweet_bind_self(int cpu)
+{
+	thread_t self = current_thread();
+	processor_t p;
+	kern_return_t kr = sweet_cpu_processor(cpu, &p);
+	spl_t s;
+
+	if (kr != KERN_SUCCESS) {
+		return kr;
+	}
+	s = splsched();
+	thread_lock(self);
+	if (p != PROCESSOR_NULL &&
+	    (self->sched_pri >= BASEPRI_RTQUEUES || self->sched_mode == TH_MODE_REALTIME)) {
+		kr = KERN_NO_ACCESS;
+	} else {
+		(void)thread_bind_internal(self, p);
+	}
+	thread_unlock(self);
+	splx(s);
+	return kr;
+}
+
+/*
+ * idx < 0: list the task's threads (task->threads order, which is what
+ * task_threads() and so ps -M print). idx >= 0: bind that thread to cpu
+ * (cpu < 0 unbinds). KERN_ABORTED: the thread sits on a run queue right now,
+ * try again.
+ */
+kern_return_t
+sweet_task_threads(task_t task, int idx, int cpu, char *out, size_t outlen)
+{
+	processor_t p = PROCESSOR_NULL;
+	kern_return_t kr = KERN_SUCCESS;
+	thread_t th;
+	size_t o = 0;
+	int i = 0, found = 0;
+	spl_t s;
+
+	if (idx >= 0 && (kr = sweet_cpu_processor(cpu, &p)) != KERN_SUCCESS) {
+		return kr;
+	}
+	out[0] = '\0';
+	if (idx < 0) {
+		o += scnprintf(out + o, outlen - o, "idx tid pri base mode bound last\n");
+	}
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (idx >= 0 && i != idx) {
+			i++;
+			continue;
+		}
+		s = splsched();
+		thread_lock(th);
+		if (idx >= 0) {
+			found = 1;
+			if (p != PROCESSOR_NULL &&
+			    (th->sched_pri >= BASEPRI_RTQUEUES || th->sched_mode == TH_MODE_REALTIME)) {
+				kr = KERN_NO_ACCESS;
+			} else if (th->runq != PROCESSOR_NULL) {
+				kr = KERN_ABORTED;
+			} else {
+				(void)thread_bind_internal(th, p);
+			}
+		}
+		o += scnprintf(out + o, outlen - o, "%d %llu %d %d %d %d %d%s\n", i,
+		    (unsigned long long)th->thread_id, th->sched_pri, th->base_pri, th->sched_mode,
+		    th->bound_processor ? th->bound_processor->cpu_id : -1,
+		    th->last_processor ? th->last_processor->cpu_id : -1,
+		    idx >= 0 ? (kr == KERN_SUCCESS ? " bound" : kr == KERN_ABORTED ? " busy" : " refused") : "");
+		thread_unlock(th);
+		splx(s);
+		if (idx >= 0) {
+			break;
+		}
+		i++;
+	}
+	task_unlock(task);
+	if (idx >= 0 && !found) {
+		scnprintf(out, outlen, "no thread %d\n", idx);
+		return KERN_INVALID_ARGUMENT;
+	}
+	return kr;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
