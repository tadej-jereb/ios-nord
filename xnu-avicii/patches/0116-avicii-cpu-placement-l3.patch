+/*
+ * Clock of the CPU this runs on, from a chain of dependent adds: each add needs
+ * the previous result, and an integer add has 1-cycle latency on both the A55
+ * and the A76, so 16 adds per iteration take 16 cycles whatever else the core
+ * can overlap. Interrupts are off for the few milliseconds it runs.
+ */
+static unsigned
+loop_mhz(void)
+{
+	const uint64_t iters = 200000;  /* 3.2 M cycles: ~1.3 ms at 2.4 GHz */
+	uint64_t x = 0, n = iters, t0, t1, ns;
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+
+	t0 = mach_absolute_time();
+	__asm__ volatile (
+                "1:\n"
+                "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                "add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+                "subs %1, %1, #1\n"
+                "b.ne 1b\n"
+                : "+r" (x), "+r" (n) :: "cc");
+	t1 = mach_absolute_time();
+	(void)ml_set_interrupts_enabled(istate);
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	return ns ? (unsigned)(iters * 16 * 1000 / ns) : 0;
+}
