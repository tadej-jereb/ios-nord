+static int
+parse_int(const char **p, int *out)
+{
+	const char *s = *p;
+	int neg = 0, v = 0, any = 0;
+
+	while (*s == ' ' || *s == '\t' || *s == '\n') {
+		s++;
+	}
+	if (*s == '-') {
+		neg = 1;
+		s++;
+	}
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10 + (*s++ - '0');
+		any = 1;
+	}
+	*p = s;
+	*out = neg ? -v : v;
+	return any;
+}
