+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(dom[d].base + OSM_PERF_STATE) = row;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	printf("SWEET CPUFREQ: domain %u (%s) row %u (%u MHz) -> row %u (%u MHz), reads %u\n",
+	    d, osm_domain_name[d], was, was < dom[d].n ? osm_mhz(dom[d].rows[was]) : 0,
+	    row, osm_mhz(dom[d].rows[row]), osm_rd(dom[d].base, OSM_PERF_STATE));
+}
