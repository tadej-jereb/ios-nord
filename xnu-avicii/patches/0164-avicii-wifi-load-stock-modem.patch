+/* SMP2P v1, topaz 0113. lito.dtsi:2895-2905 names fatal and ready. */
+bool
+sweet_smem_mpss_state(uint32_t *state)
+{
+	volatile uint8_t *part = mpss_part;
+	if (!part) {
+		return false;
+	}
+	uint32_t end = smem_rd32(part, 12);
+	if (end > smem_rd32(part, 8) || end > SMEM_SIZE - (size_t)(part - smem_base)) {
+		return false;
+	}
+
+	__asm__ volatile("dmb oshld" ::: "memory");
+	for (uint32_t pos = sizeof(struct smem_part_hdr); pos + sizeof(struct smem_priv_entry) <= end;) {
+		if (smem_rd16(part, pos) != SMEM_CANARY) {
+			return false;
+		}
+		uint16_t item = smem_rd16(part, pos + 2);
+		uint32_t size = smem_rd32(part, pos + 4);
+		uint16_t pad_data = smem_rd16(part, pos + 8);
+		uint32_t data = pos + sizeof(struct smem_priv_entry) + smem_rd16(part, pos + 10);
+		if (data > end || size > end - data || pad_data > size || (data & 3u)) {
+			return false;
+		}
+		if (item == SMEM_ITEM_SMP2P_IN) {
+			volatile uint8_t *header = part + data;
+			uint32_t usable = size - pad_data;
+			if (usable < 20 || !smem_magic(header, 0, "$SMP") || header[4] != 1 ||
+			    smem_rd16(header, 8) != HOST_MPSS || smem_rd16(header, 10) != HOST_APPS) {
+				return false;
+			}
+			uint16_t valid = smem_rd16(header, 14);
+			if (valid > smem_rd16(header, 12) || valid > (usable - 20) / 20) {
+				return false;
+			}
+			__asm__ volatile("dmb oshld" ::: "memory");
+			for (uint16_t i = 0; i < valid; i++) {
+				volatile uint8_t *entry = header + 20 + 20 * i;
+				char name[17];
+				for (unsigned j = 0; j < 16; j++) {
+					name[j] = (char)entry[j];
+				}
+				name[16] = 0;
+				if (strcmp(name, "slave-kernel") == 0) {
+					*state = smem_rd32(entry, 16);
+					return true;
+				}
+			}
+			return false;
+		}
+		pos = data + size;
+	}
+	return false;
+}
