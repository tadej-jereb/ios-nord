+/*
+ * This rung supports the verified Nord firmware placement. The MDT was
+ * authenticated first. Its preferred addresses already match the reserved
+ * physical window, so no relocation is needed.
+ */
+static bool
+modem_load_verified_layout(void)
+{
+	if (strcmp(modem_part, "modem_a") != 0 || mdt.min_addr != MODEM_REGION_PA ||
+	    mdt.max_addr != MODEM_REGION_PA + MODEM_REGION_SIZE) {
+		MLOG("step W4 stop: firmware layout differs from the verified modem_a image");
+		return false;
+	}
+	for (uint32_t i = 0; i < mdt.phnum; i++) {
+		const struct mdt_seg *seg = &mdt.seg[i];
+		if (!seg->load) {
+			continue;
+		}
+		struct mfw_file file;
+		if (seg->filesz && (mdt_open_seg(i, &file) || file.size != seg->filesz)) {
+			MLOG("step W4 stop: segment %u missing or wrong size", i);
+			return false;
+		}
+		vm_offset_t pa = trunc_page_64(seg->paddr);
+		vm_size_t offset = seg->paddr - pa;
+		vm_size_t mapped = round_page_64(offset + (uint64_t)seg->memsz);
+		if (pa < MODEM_REGION_PA || mapped > MODEM_REGION_PA + MODEM_REGION_SIZE - pa) {
+			MLOG("step W4 stop: segment %u mapping would leave the reserved window", i);
+			return false;
+		}
+		vm_offset_t va = ml_io_map_unmappable(pa, mapped, VM_WIMG_WCOMB);
+		if (!va) {
+			MLOG("step W4 stop: segment %u could not map", i);
+			return false;
+		}
+		MLOG("step W4 load: segment %u, %u file bytes, %u memory bytes",
+		    i, seg->filesz, seg->memsz);
+		uint8_t *dst = (uint8_t *)(va + offset);
+		int error = seg->filesz ? mfw_read(&file, 0, dst, seg->filesz) : 0;
+		if (!error && seg->memsz > seg->filesz) {
+			bzero(dst + seg->filesz, seg->memsz - seg->filesz);
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+		ml_io_unmap(va, mapped);
+		if (error) {
+			MLOG("step W4 stop: segment %u read failed: %d", i, error);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+modem_wait_ready(void)
+{
+	uint32_t state, last = 0;
+	bool seen = false;
+	for (unsigned i = 0; i < 250; i++) {
+		if (sweet_smem_mpss_state(&state)) {
+			if (!seen || state != last) {
+				MLOG("step W4 slave-kernel: %#x", state);
+				seen = true;
+				last = state;
+			}
+			if (state & 1u) {
+				MLOG("step W4 FAIL: modem signaled fatal");
+				return;
+			}
+			if (state & 2u) {
+				MLOG("step W4 PASS: modem signaled READY");
+				return;
+			}
+		}
+		sweet_modem_sleep_ms(20);
+	}
+	MLOG("step W4 timeout: READY absent, slave-kernel %s %#x", seen ? "last" : "unavailable", last);
+}
 
