+/*
+ * 0148: avicii has no RTC driver, so the wall clock started at 1970. Boot-arg
+ * sweettime=<unix seconds> (stamped by tooling/71-phone-image.sh when the image
+ * is built) seeds it; clock_initialize_calendar() reads this once at boot and the
+ * calendar then advances on its own. Without the boot-arg: unchanged (epoch).
+ * Idea and shape from refs/rrrd-jpg-ios-sweet/xnu/patches/0086-sweet-wall-clock.patch.
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint64_t base = 0;
+	if (!PE_parse_boot_argn("sweettime", &base, sizeof(base))) {
+		return 0;
+	}
+	return (long)base;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	(void)secs;     /* no RTC to write it to */
+}
