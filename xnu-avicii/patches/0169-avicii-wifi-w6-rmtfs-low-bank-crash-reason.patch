+/*
+ * The modem's crash reason: SMEM item 421 (qcom,mss qcom,smem-id = <421>, lito.dtsi:2881), which the
+ * vendor PIL reads with qcom_smem_get(QCOM_SMEM_HOST_ANY, ...): the global partition, hosts 0xfffe/0xfffe
+ * (anonbeat1 0113 found its WPSS crash item there). Read-only; prints printable characters only.
+ */
+#define SMEM_GLOBAL_HOST        0xfffeu
+#define SMEM_ITEM_MPSS_SFR      421u
+void
+sweet_smem_mpss_crash_reason(void)
+{
+	volatile uint8_t *glob = NULL;
+
+	if (!smem_base || !smem_magic(smem_base, SMEM_TABLE_OFF, "$TOC")) {
+		return;
+	}
+	uint32_t n = smem_rd32(smem_base, SMEM_TABLE_OFF + 8);
+	for (uint32_t i = 0; i < n && i < SMEM_ITEMS_MAX; i++) {
+		uint32_t e = SMEM_TABLE_OFF + sizeof(struct smem_pt) + i * sizeof(struct smem_pt_entry);
+		uint32_t off = smem_rd32(smem_base, e), size = smem_rd32(smem_base, e + 4);
+		if (smem_rd16(smem_base, e + 12) == SMEM_GLOBAL_HOST && smem_rd16(smem_base, e + 14) == SMEM_GLOBAL_HOST &&
+		    off != 0 && off < SMEM_SIZE && size <= SMEM_SIZE - off) {
+			glob = smem_base + off;
+		}
+	}
+	if (!glob || !smem_magic(glob, 0, "$PRT")) {
+		printf("SWEET SMEM: crash reason: no global partition\n");
+		return;
+	}
+	uint32_t end = smem_rd32(glob, 12);
+	for (uint32_t pos = sizeof(struct smem_part_hdr); pos + sizeof(struct smem_priv_entry) <= end;) {
+		if (smem_rd16(glob, pos) != SMEM_CANARY) {
+			break;
+		}
+		uint32_t size = smem_rd32(glob, pos + 4);
+		uint32_t data = pos + sizeof(struct smem_priv_entry) + smem_rd16(glob, pos + 10);
+		if (data > end || size > end - data) {
+			break;
+		}
+		if (smem_rd16(glob, pos + 2) == SMEM_ITEM_MPSS_SFR) {
+			char text[201];
+			uint32_t k = 0;
+			for (uint32_t j = 0; j < size && k < 200; j++) {
+				uint8_t c = glob[data + j];
+				if (c == 0) {
+					break;
+				}
+				text[k++] = smem_namec(c);
+			}
+			text[k] = 0;
+			printf("SWEET SMEM: modem crash reason (item %u, %u B): \"%s\"\n", SMEM_ITEM_MPSS_SFR, size, text);
+			return;
+		}
+		pos = data + size;
+	}
+	printf("SWEET SMEM: crash reason: item %u not in the global partition\n", SMEM_ITEM_MPSS_SFR);
+}
