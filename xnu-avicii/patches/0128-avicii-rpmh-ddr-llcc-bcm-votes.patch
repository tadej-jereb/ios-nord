+/*
+ * DDR / LLCC / ACV bandwidth votes (docs/perf-research/A-ddr-bandwidth.md). The vendor's devbw/bwmon/
+ * memlat governors vote these BCMs on the APPS RSC; nothing in this kernel did, so DDR and LLCC stayed
+ * at whatever the boot loader left. A vote is one ACTIVE-TCS command with commit and valid set and the
+ * peak (IB) in the BCM's unit -- the dts table integers: MC0 7980 = DDR 2092 MHz, SH0 16265 = LLCC
+ * 1066 MHz (lito.dtsi ddr_bw_opp_table / llcc_bw_opp_table), ACV 8 = the APPS active bit. 0 releases.
+ * Boot-args sweetddr=<MC0 IB> sweetllcc=<SH0 IB> sweetacv=0|1 (default: no vote). Runtime: write
+ * "NAME VALUE" to kern.sweet_bcm. kern.sweet_bwtest: write a count, read the memcpy MiB/s.
+ */
+static char rh_bcm_log[512];
+static size_t rh_bcm_logpos;
+
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t ib)
+{
+	if (!res || ib > RH_BCM_MASK) {
+		return EINVAL;
+	}
+	if (strcmp(res, "MC0") && strcmp(res, "SH0") && strcmp(res, "ACV") && strcmp(res, "CN0")) {
+		printf("SWEET RPMH: %s is not a BCM this kernel votes\n", res);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, value = ib ? (RH_BCM_COMMIT | RH_BCM_VALID | ib) : RH_BCM_COMMIT;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send_cmds(&address, &value, 1);
+	}
+out:
+	printf("SWEET RPMH: BCM %s vote %u (word %#x) at %#x -> %d\n", res, ib, value, address, error);
+	if (rh_bcm_logpos < sizeof(rh_bcm_log) - 64) {
+		rh_bcm_logpos += (size_t)scnprintf(rh_bcm_log + rh_bcm_logpos, sizeof(rh_bcm_log) - rh_bcm_logpos,
+		    "%s %u -> %d\n", res, ib, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+void
+sweet_rpmh_bcm_boot(void)
+{
+	uint32_t ddr = 0, llcc = 0, acv = 1;
+	bool any = PE_parse_boot_argn("sweetddr", &ddr, sizeof(ddr)) | PE_parse_boot_argn("sweetllcc", &llcc, sizeof(llcc));
+	(void)PE_parse_boot_argn("sweetacv", &acv, sizeof(acv));
+	if (!any || (ddr == 0 && llcc == 0)) {
+		return;
+	}
+	if (acv) {
+		(void)sweet_rpmh_bcm_vote("ACV", 8u);
+	}
+	if (llcc) {
+		(void)sweet_rpmh_bcm_vote("SH0", llcc);
+	}
+	if (ddr) {
+		(void)sweet_rpmh_bcm_vote("MC0", ddr);
+	}
+}
+
+static int
+sysctl_sweet_bcm SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char in[32] = "";
+	char name[8] = "";
+	uint32_t v = 0;
+	unsigned i = 0, k = 0;
+	int error;
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, rh_bcm_log, rh_bcm_logpos + 1);
+	}
+	if (req->newlen >= sizeof(in)) {
+		return EINVAL;
+	}
+	if ((error = SYSCTL_IN(req, in, req->newlen))) {
+		return error;
+	}
+	while (in[i] == ' ') {
+		i++;
+	}
+	while (in[i] && in[i] != ' ' && k < sizeof(name) - 1) {
+		name[k++] = in[i++];
+	}
+	while (in[i] == ' ') {
+		i++;
+	}
+	while (in[i] >= '0' && in[i] <= '9') {
+		v = v * 10u + (uint32_t)(in[i++] - '0');
+	}
+	return sweet_rpmh_bcm_vote(name, v);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_bcm, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_bcm, "A", "SWEET RPMh BCM vote: \"NAME IB\" (MC0, SH0, ACV, CN0)");
+
+/* memcpy bandwidth: two 8 MiB buffers, `count` copies, MiB/s of bytes read + written */
+static char rh_bw_out[128] = "write a count\n";
+static int
+sysctl_sweet_bwtest SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int count = 0, error;
+	char in[8] = "";
+	vm_offset_t a = 0, b = 0;
+	const vm_size_t size = 8u << 20;
+	uint64_t t0, t1, ns;
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, rh_bw_out, strlen(rh_bw_out) + 1);
+	}
+	if (req->newlen >= sizeof(in)) {
+		return EINVAL;
+	}
+	if ((error = SYSCTL_IN(req, in, req->newlen))) {
+		return error;
+	}
+	for (unsigned i = 0; in[i] >= '0' && in[i] <= '9'; i++) {
+		count = count * 10 + (in[i] - '0');
+	}
+	if (count < 1 || count > 64) {
+		return EINVAL;
+	}
+	if (kmem_alloc(kernel_map, &a, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	if (kmem_alloc(kernel_map, &b, size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
+		kmem_free(kernel_map, a, size);
+		return ENOMEM;
+	}
+	bcopy((void *)a, (void *)b, size);      /* fault everything in first */
+	t0 = mach_absolute_time();
+	for (int i = 0; i < count; i++) {
+		bcopy((i & 1) ? (void *)b : (void *)a, (i & 1) ? (void *)a : (void *)b, size);
+	}
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	kmem_free(kernel_map, a, size);
+	kmem_free(kernel_map, b, size);
+	(void)scnprintf(rh_bw_out, sizeof(rh_bw_out), "%d x 8 MiB copies in %llu us: %llu MiB/s copied (x2 for read+write)\n",
+	    count, ns / 1000, ns ? (uint64_t)count * 8u * 1000000000ull / ns : 0);
+	printf("SWEET BW: %s", rh_bw_out);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_bwtest, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_bwtest, "A", "SWEET memcpy bandwidth test: write a count (1..64), read the result");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
