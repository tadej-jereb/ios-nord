+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	/* HPM (raw 7) is valid for a PMIC5 LDO and for an HF SMPS; enable last. */
+	const uint32_t addrs[3] = {address, address + 8u, address + 4u};
+	const uint32_t values[3] = {mv, 7, 1};
+	return rh_send_cmds(addrs, values, 3);
+}
