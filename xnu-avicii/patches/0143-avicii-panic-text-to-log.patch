 void
 debug_putc(char c)
 {
+#if defined(SWEET)
+	/*
+	 * 0143: the panic string, backtrace and paniclog go out through
+	 * kdb_printf -> debug_putc, not _cnputs, so they never reached the
+	 * sweetlog ring (0142 test 2026-11-16: previous boot ended with
