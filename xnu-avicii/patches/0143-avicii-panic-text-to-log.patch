+	 */
+	if (panic_active()) {
+		extern void sweet_log_append(const char *c, int size);
+		sweet_log_append(&c, 1);
+	}
+#endif
 	if ((debug_buf_size != 0) &&
 	    ((debug_buf_ptr - debug_buf_base) < (int)debug_buf_size)) {
 		*debug_buf_ptr = c;
