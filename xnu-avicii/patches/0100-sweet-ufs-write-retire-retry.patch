 /*
+ * The host retires the slot itself, but the device may still own the bounce
+ * buffer until it does. A late DMA into a buffer that has already been rebuilt
+ * for the next command lands that command's data somewhere else on disk, so the
+ * slot is only reused once it is retired - bounded, and cleared if it is not.
+ */
+static void
+ufs_retire(void)
+{
+	for (int i = 0; i < 1000 && (ufs_rd(REG_UTRLDBR) & 1); i++) {
+		delay(1000);
+	}
+	if (ufs_rd(REG_UTRLDBR) & 1) {
+		ufs_wr(REG_UTRLCLR, ~1u);
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+}
+
+/* Response UPIU: response at 6, status at 7, residual at 12, fixed sense at 34. */
+#define UPIU_STATUS_CHECK       0x02
+#define UPIU_STATUS_BUSY        0x08
+#define UPIU_STATUS_TSFULL      0x28
+#define SENSE_NOT_READY         0x02
+#define SENSE_UNIT_ATTENTION    0x06
+
+static inline uint32_t
+be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+/* Sense key of the last response, 0 when there is no fixed-format sense data. */
+static inline uint8_t
+ufs_sense_key(const struct ucd *ucd)
+{
+	return ucd->resp[33] >= 14 ? (uint8_t)(ucd->resp[36] & 0x0f) : 0;
+}
+
+/*
+ * Whether repeating the command can help. Every command this driver issues is
+ * idempotent (same LBA, same data), so a write is retried like a read.
+ */
+static inline bool
+ufs_retryable(uint8_t status, uint8_t key)
+{
+	return status == UPIU_STATUS_BUSY || status == UPIU_STATUS_TSFULL ||
+	    (status == UPIU_STATUS_CHECK && (key == SENSE_NOT_READY || key == SENSE_UNIT_ATTENTION));
+}
+
+/*
  * One SCSI command in slot 0, data (if any) to/from the bounce buffer
  * (to the device when write is set). Returns 0 or an errno.
  */
@@ -151,7 +202,9 @@
