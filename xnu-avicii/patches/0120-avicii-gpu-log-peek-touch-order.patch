+/*
+ * The bring-up log, kept: the GPU thread runs before USB is up and the message buffer wraps
+ * within a minute, so every SWEET GPU line also lands here (sysctl kern.sweet_gpu).
+ */
+#define GPU_LOG_LEN 8192
+static char gpu_logbuf[GPU_LOG_LEN];
+static size_t gpu_logpos;
+
+static void gpu_log(const char *fmt, ...) __printflike(1, 2);
+static void
+gpu_log(const char *fmt, ...)
+{
+	char line[256];
+	va_list ap;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("%s", line);
+	size_t n = strlen(line);
+	if (gpu_logpos + n < GPU_LOG_LEN) {
+		memcpy(gpu_logbuf + gpu_logpos, line, n);
+		gpu_logpos += n;
+	}
+}
