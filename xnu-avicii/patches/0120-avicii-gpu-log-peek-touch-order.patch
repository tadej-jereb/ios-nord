+/*
+ * kern.sweet_gpu_peek: write "PA [N]" (hex PA, N <= 64 words), read back the words. Only
+ * inside windows this driver already brought up, because a read of a block whose clock or
+ * power is off aborts: GCC (always clocked), GPUCC once gcc_gpu_cfg_ahb is on (stage >= 1),
+ * the GMU window once its clocks are on (stage >= 5). The 3D core and SMMU stay closed.
+ */
+static char gpu_peek_out[2048] = "write \"PA [N]\"\n";
+
+static vm_offset_t
+gpu_peek_va(uint64_t pa)
+{
+	if (gpu_gcc && pa >= GPU_GCC_PA && pa < GPU_GCC_PA + GPU_GCC_SIZE) {
+		return gpu_gcc + (vm_offset_t)(pa - GPU_GCC_PA);
+	}
+	if (gpu_gpucc && pa >= GPU_GPUCC_PA && pa < GPU_GPUCC_PA + GPU_GPUCC_SIZE) {
+		return gpu_gpucc + (vm_offset_t)(pa - GPU_GPUCC_PA);
+	}
+	if (gpu_gmu && pa >= A6XX_GMU_PA && pa < A6XX_GMU_PA + A6XX_GMU_SIZE) {
+		return gpu_gmu + (vm_offset_t)(pa - A6XX_GMU_PA);
+	}
+	return 0;
+}
+
+static int
+sysctl_sweet_gpu_peek SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char in[48] = "";
+	const char *p = in;
+	uint64_t pa = 0;
+	unsigned n = 0;
+	size_t o = 0;
+	int error;
+
+	if (req->newptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, gpu_peek_out, strlen(gpu_peek_out) + 1);
+	}
+	if (req->newlen >= sizeof(in)) {
+		return EINVAL;
+	}
+	if ((error = SYSCTL_IN(req, in, req->newlen))) {
+		return error;
+	}
+	while (*p == ' ') {
+		p++;
+	}
+	if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
+		p += 2;
+	}
+	for (; *p; p++) {
+		unsigned d = (*p >= '0' && *p <= '9') ? (unsigned)(*p - '0') :
+		    (*p >= 'a' && *p <= 'f') ? (unsigned)(*p - 'a' + 10) :
+		    (*p >= 'A' && *p <= 'F') ? (unsigned)(*p - 'A' + 10) : 16u;
+		if (d == 16u) {
+			break;
+		}
+		pa = pa << 4 | d;
+	}
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		n = n * 10u + (unsigned)(*p++ - '0');
+	}
+	if (n == 0) {
+		n = 1;
+	}
+	if (n > 64u || (pa & 3u)) {
+		return EINVAL;
+	}
+	for (unsigned i = 0; i < n; i++) {
+		vm_offset_t va = gpu_peek_va(pa + 4u * i);
+		if (!va) {
+			o += (size_t)scnprintf(gpu_peek_out + o, sizeof(gpu_peek_out) - o, "%#llx closed\n",
+			    (unsigned long long)(pa + 4u * i));
+			break;
+		}
+		if ((i & 3u) == 0) {
+			o += (size_t)scnprintf(gpu_peek_out + o, sizeof(gpu_peek_out) - o, "%s%#llx:",
+			    i ? "\n" : "", (unsigned long long)(pa + 4u * i));
+		}
+		o += (size_t)scnprintf(gpu_peek_out + o, sizeof(gpu_peek_out) - o, " %08x", *(volatile uint32_t *)va);
+		if (o >= sizeof(gpu_peek_out) - 16) {
+			break;
+		}
 	}
+	(void)scnprintf(gpu_peek_out + o, sizeof(gpu_peek_out) - o, "\n");
+	return 0;
 }
+SYSCTL_PROC(_kern, OID_AUTO, sweet_gpu_peek, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweet_gpu_peek, "A", "SWEET GPU register read: \"PA [N]\"");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
