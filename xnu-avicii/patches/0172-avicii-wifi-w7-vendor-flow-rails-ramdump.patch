+/*
+ * The modem's crash dumps (0172). On 0171 the WLAN PD crashed after every handshake and wrote
+ * /ramdumps/wlan_minidump.<date>.00.elf (~8 MB) over tftp; we dropped it. The first dump of the boot is kept in
+ * one fixed 16 MB buffer (allocated on the first write, never moved, so the sysctl can read it at any time),
+ * its crash strings go to the log, and `sysctl -b kern.sweetwlandump` returns the whole file.
+ */
+#define RD_MAX          (16u << 20)
+static uint8_t *rd_buf;
+static uint32_t rd_size, rd_scanned, rd_dropped;
+static char rd_name[96];
+
+static bool
+rd_open(const char *path)
+{
+	if (rd_name[0] != 0 && strcmp(rd_name, path) != 0) {
+		rd_dropped++;
+		return false;                           /* only the first dump of the boot */
+	}
+	if (rd_buf == NULL) {
+		rd_buf = kalloc_data(RD_MAX, Z_WAITOK | Z_ZERO);
+		if (rd_buf == NULL) {
+			MLOG("step W6 ramdump: no memory for %u MB", RD_MAX >> 20);
+			return false;
+		}
+		strlcpy(rd_name, path, sizeof(rd_name));
+	}
+	return true;
+}
+
+static void
+rd_write(uint64_t off, const uint8_t *src, uint32_t n)
+{
+	if (off >= RD_MAX || n > RD_MAX - off) {
+		return;
+	}
+	memcpy(rd_buf + off, src, n);
+	if (off + n > rd_size) {
+		rd_size = (uint32_t)(off + n);
+	}
+}
+
+static bool
+rd_interesting(const char *t, uint32_t n)
+{
+	static const char *const keys[] = {
+		"rror", "RROR", "xcept", "atal", "ATAL", "ssert", "rash", "anic", "bort", "dog", ".c:", ".c ", "fail", "FAIL",
+	};
+	for (unsigned k = 0; k < sizeof(keys) / sizeof(keys[0]); k++) {
+		size_t kl = strlen(keys[k]);
+		for (uint32_t i = 0; i + kl <= n; i++) {
+			if (memcmp(t + i, keys[k], kl) == 0) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+/* print the printable runs (>= 12 chars) of the dump that look like an error: what killed the PD */
+static void
+rd_scan(const char *why)
+{
+	uint32_t printed = 0, run = 0;
+	char line[161];
+
+	if (rd_buf == NULL || rd_size == 0 || rd_size == rd_scanned) {
+		return;
+	}
+	MLOG("step W6 ramdump %s: %u B (%s), scan %s", rd_name, rd_size, rd_dropped ? "later dumps dropped" : "first",
+	    why);
+	for (uint32_t i = 0; i <= rd_size && printed < 40; i++) {
+		uint8_t c = i < rd_size ? rd_buf[i] : 0;
+		if (c >= 0x20 && c < 0x7f) {
+			run++;
+			continue;
+		}
+		if (run >= 12 && rd_interesting((const char *)rd_buf + i - run, run)) {
+			uint32_t n = MIN(run, (uint32_t)sizeof(line) - 1);
+			memcpy(line, rd_buf + i - run, n);
+			line[n] = 0;
+			MLOG("step W6 ramdump @%#x: %s", i - run, line);
+			printed++;
+		}
+		run = 0;
+	}
+	MLOG("step W6 ramdump: %u line(s); whole file: sysctl -b kern.sweetwlandump", printed);
+	rd_scanned = rd_size;
+}
+
+static int
+sysctl_sweetwlandump SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	return rd_buf == NULL ? 0 : SYSCTL_OUT(req, rd_buf, rd_size);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweetwlandump, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_sweetwlandump, "S", "the modem's first /ramdumps/*.elf of this boot (0172)");
