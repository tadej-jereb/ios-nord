+ */
+static int g_bo_wc = -1;
+static bool
+gpu_bo_wc(void)
+{
+	if (g_bo_wc < 0) {
+		int v = 0;
+		g_bo_wc = PE_parse_boot_argn("sweetgpu_bowc", &v, sizeof(v)) && v != 0;
+	}
+	return g_bo_wc != 0;
