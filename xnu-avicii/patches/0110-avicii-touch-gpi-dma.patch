+static void
+gsi_put(uint32_t roff, unsigned *wp, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(gsi_va(roff) + *wp * 16);
+	t[0] = d0, t[1] = d1, t[2] = d2, t[3] = d3;
+	gsi_flush(roff + *wp * 16, 16);
+	*wp = (*wp + 1) % GSI_NTRE;
+}
+
+/* Walk new events: return the first error code seen, recycle the ring. */
+static uint32_t
+gsi_events(void)
+{
+	uint32_t bad = 0;
+	gsi_flush(GSI_OFF_EV, GSI_NTRE * 16);
+	uint32_t hw = touch_rd(st.gpi, GSI_EV_CTX + 0x10);
+	while (gsi_lo(gsi_pa(GSI_OFF_EV) + st.ev_rp * 16) != hw) {
+		volatile uint32_t *e = (volatile uint32_t *)(gsi_va(GSI_OFF_EV) + st.ev_rp * 16);
+		uint32_t type = (e[3] >> 16) & 0xffu, code = (e[2] >> 24) & 0xffu;
+		if (type == 0x22 && code == 16 && !bad) {      /* XFER_COMPLETE, UNEXP_ERR */
+			bad = e[3] & 0xffffu ? e[3] : 0x10000u;
+		} else if (type == 0x31) {                     /* QUP_NOTIF: SE m_irq status */
+			printf("SWEET TOUCH: GSI notif status %#x time %#x count %#x\n",
+			    e[0], e[1], e[2] & 0xffffffu);
+			if ((e[0] & SE_ERRORS) && !bad) {
+				bad = e[0];
+			}
+		}
+		st.ev_rp = (st.ev_rp + 1) % GSI_NTRE;
+	}
+	touch_wr(st.gpi, GSI_EV_DB, gsi_lo(gsi_pa(GSI_OFF_EV) +
+	    ((st.ev_rp + GSI_NTRE - 1) % GSI_NTRE) * 16));
+	touch_wr(st.gpi, GSI_IEOB_CLR, 1);
+	return bad;
+}
+
+/*
+ * One I2C message, laid out as gpi_create_i2c_tre() for geni_i2c_gpi_xfer:
+ * a write carries CONFIG0 (chain) + GO(WRITE, chain) + DMA(ieot) on the TX
+ * ring; a read is a DMA(ieot) on the RX ring and GO(READ, rx_len, link) on TX.
+ */
+static int
+gsi_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx, unsigned nr, bool stretch)
+{
+	static unsigned logged;
+	if (touch_debug && logged < 6) {
+		logged++;
+		printf("SWEET TOUCH: GSI msg %s addr=%#x len=%u\n", nr ? "read" : "write", addr,
+		    nr ? nr : nt);
+		gsi_step("gsi doorbell");
+	}
+	uint32_t go = ((uint32_t)addr << 8) | (stretch ? 1u << 26 : 0u);
+	if (nt) {
+		volatile uint8_t *d = (volatile uint8_t *)gsi_va(GSI_OFF_DTX);
+		for (unsigned i = 0; i < nt; i++) {
+			d[i] = tx[i];
+		}
+		gsi_flush(GSI_OFF_DTX, 64);
+		/* 100 kHz: tlow 11, thigh 10, tcycle 26, tx/rx pack; clk_div 7 */
+		gsi_put(GSI_OFF_TX, &st.tx_wp, 3u << 24 | 26u << 16 | 10u << 8 | 11u, 0, 7u,
+		    TRE_CONFIG0 | TRE_CHAIN);
+		gsi_put(GSI_OFF_TX, &st.tx_wp, go | 1u, 0, nt, TRE_GO | TRE_CHAIN);
+		gsi_put(GSI_OFF_TX, &st.tx_wp, gsi_lo(gsi_pa(GSI_OFF_DTX)),
+		    gsi_hi(gsi_pa(GSI_OFF_DTX)), nt, TRE_DMA | TRE_IEOT);
+	} else {
+		memset((void *)gsi_va(GSI_OFF_DRX), 0xa5, 128);
+		gsi_flush(GSI_OFF_DRX, 128);
+		gsi_put(GSI_OFF_RX, &st.rx_wp, gsi_lo(gsi_pa(GSI_OFF_DRX)),
+		    gsi_hi(gsi_pa(GSI_OFF_DRX)), nr, TRE_DMA | TRE_IEOT);
+		gsi_put(GSI_OFF_TX, &st.tx_wp, go | 2u, 0, nr, TRE_GO | TRE_LINK);
+	}
+	uint32_t txw = gsi_lo(gsi_pa(GSI_OFF_TX) + st.tx_wp * 16);
+	uint32_t rxw = gsi_lo(gsi_pa(GSI_OFF_RX) + st.rx_wp * 16);
+	if (nr) {
+		touch_wr(st.gpi, GSI_CH_DB(1), rxw);
+	}
+	touch_wr(st.gpi, GSI_CH_DB(0), txw);
+	int err = ETIMEDOUT;
+	for (unsigned t = 0; t < 100000; t++) {      /* 100 ms */
+		uint32_t bad = gsi_events();
+		if (bad) {
+			st.gsi_err = bad;
+			err = ENXIO;
+			break;
+		}
+		if (touch_rd(st.gpi, GSI_CH_CTX(0) + 0x10) == txw &&
+		    (!nr || touch_rd(st.gpi, GSI_CH_CTX(1) + 0x10) == rxw)) {
+			err = 0;
+			break;
+		}
+		delay(1);
+	}
+	if (err) {
+		printf("SWEET TOUCH: GSI %s addr=%#x len=%u err=%d ev=%#x ch0 rp %#x/%#x ch1 rp %#x/%#x "
+		    "ctx %#x/%#x glob %#x geni %#x m_irq %#x\n", nr ? "read" : "write", addr,
+		    nr ? nr : nt, err, st.gsi_err, touch_rd(st.gpi, GSI_CH_CTX(0) + 0x10), txw,
+		    touch_rd(st.gpi, GSI_CH_CTX(1) + 0x10), rxw, touch_rd(st.gpi, GSI_CH_CTX(0)),
+		    touch_rd(st.gpi, GSI_CH_CTX(1)), touch_rd(st.gpi, G(0x23100u)),
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+		/* The channels are now out of step with our ring pointers. */
+		st.dead = true;
+		return err;
+	}
+	if (nr) {
+		gsi_flush(GSI_OFF_DRX, 128);
+		for (unsigned i = 0; i < nr; i++) {
+			rx[i] = ((volatile uint8_t *)gsi_va(GSI_OFF_DRX))[i];
+		}
+	}
+	st.sent = nt;
+	st.got = nr;
+	return 0;
+}
