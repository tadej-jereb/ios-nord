--- a/bsd/dev/sweet_cpufreq.c
+++ b/bsd/dev/sweet_cpufreq.c
@@ -223,6 +223,54 @@ loop_mhz(void)
 
 #define REPORT_LEN 4096
 
+/*
+ * SoC temperatures: iOS has no thermal driver here and 0115/0116 run every
+ * domain at its top level, so the report shows them. lito tsens0/tsens1
+ * ("qcom,tsens26xx", lito.dtsi:1599-1625) have their TM blocks at 0xc263000 and
+ * 0xc265000. Per LineageOS android_kernel_oneplus_sm7250 lineage-20
+ * drivers/thermal/tsens.h:24 and tsens2xxx.c:29-55,73-83,296-302: sensor n's
+ * status is TM + 0xa0 + 4n, [11:0] signed temperature in 0.1 C, bit 21 valid.
+ * Read-only; LMh and the PMIC still clamp in hardware.
+ */
+#define TSENS_N         2
+#define TSENS_SENSORS   16u
+static const uint64_t tsens_tm_pa[TSENS_N] = { 0x0c263000ull, 0x0c265000ull };
+static vm_offset_t tsens_tm[TSENS_N];
+
+static size_t
+sweet_tsens_report(char *buf, size_t len)
+{
+	size_t o = 0;
+	int hottest = -1000;
+
+	o += scnprintf(buf + o, len - o, "temp C (0.1):");
+	for (unsigned c = 0; c < TSENS_N; c++) {
+		if (!tsens_tm[c]) {
+			tsens_tm[c] = ml_io_map(tsens_tm_pa[c], 0x1000);
+		}
+		if (!tsens_tm[c]) {
+			continue;
+		}
+		o += scnprintf(buf + o, len - o, " |%u", c);
+		for (unsigned n = 0; n < TSENS_SENSORS; n++) {
+			uint32_t v = osm_rd(tsens_tm[c], 0xa0u + 4u * n);
+			if (!(v & (1u << 21))) {
+				continue;
+			}
+			int t = (int)(v & 0xfffu);
+			if (t & 0x800) {
+				t -= 0x1000;
+			}
+			if (t > hottest) {
+				hottest = t;
+			}
+			o += scnprintf(buf + o, len - o, " %u:%d", n, t);
+		}
+	}
+	o += scnprintf(buf + o, len - o, "\nhottest %d.%d C\n", hottest / 10, hottest % 10 < 0 ? -(hottest % 10) : hottest % 10);
+	return o;
+}
+
 static int
 sysctl_sweet_cpufreq SYSCTL_HANDLER_ARGS
 {
@@ -264,6 +312,7 @@ sysctl_sweet_cpufreq SYSCTL_HANDLER_ARGS
 		}
 		o += scnprintf(buf + o, REPORT_LEN - o, "\n");
 	}
+	o += sweet_tsens_report(buf + o, REPORT_LEN - o);
 	o += scnprintf(buf + o, REPORT_LEN - o, "loop MHz per cpu:");
 	for (int cpu = 0; cpu <= ml_get_max_cpu_number(); cpu++) {
 		unsigned mhz = 0;
