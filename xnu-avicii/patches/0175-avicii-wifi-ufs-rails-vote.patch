 			if (sweet_modem_level >= 6) {
 				msvc_prepare();         /* tftp files into RAM while the modem is still off */
 			}
+			ufs_rails_vote();
 			sweet_smem_mpss_diag("before start");
 			MLOG("step W4 auth_and_reset: starting stock MPSS firmware");
 			status = sweet_modem_scm(SCM_FN(2, 5), 1, MODEM_PAS_ID, 0, 0, 0, &result);
