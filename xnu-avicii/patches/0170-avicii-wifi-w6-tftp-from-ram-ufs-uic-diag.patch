+/* what the modem fetched over tftp on 0169 (logs/phone/20261120-wifi-0169): all of it lives under these */
+static const char *const preload_paths[] = {
+	"image/modem_pr",                       /* so/, mcfg/ (carrier configs): 34.4 MB on the modem_a backup */
