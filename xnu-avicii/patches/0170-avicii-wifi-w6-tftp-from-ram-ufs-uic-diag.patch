+/* ---- in-RAM index (0170) ----
+ * 0169 on the phone: ~21 s after READY every UFS command timed out (UIC error, logs/phone/20261120-wifi-0169),
+ * so the tftp server must not need UFS while the modem runs. The whole volume is indexed once (modem_a backup:
+ * 553 files, 529 directories), and mfw_preload() copies the files the modem fetches into RAM before it starts.
+ */
+#define IDX_MAX_NODES   8192u
+#define IDX_NAMES       (256u << 10)
+#define PRELOAD_MAX     (96ull << 20)           /* modem_a: image/modem_pr 34.4 MB + wlanmdsp.mbn 4.1 MB */
+
+struct mfw_node {
+	uint32_t parent;                        /* node index; node 0 is the root directory */
+	uint32_t name;                          /* offset in fidx.names */
+	uint32_t first, size;
+	bool dir;
+	uint8_t *ram;                           /* the whole file once preloaded */
+};
+
+static struct {
+	bool built;
+	struct mfw_node *n;
+	uint32_t count;
+	char *names;
+	uint32_t names_used;
+	uint64_t ram_bytes;
+} fidx;
+
+static uint8_t idx_empty[1];                    /* the RAM copy of a zero-byte file */
+
+struct idx_ctx {
+	uint32_t parent;
+	bool full;
+};
+
+static int
+idx_cb(void *ctx, const char *name, const struct mfw_ent *e)
+{
+	struct idx_ctx *c = ctx;
+	uint32_t l = (uint32_t)strlen(name) + 1;
+	struct mfw_node *n;
+
+	if (fidx.count >= IDX_MAX_NODES || fidx.names_used + l > IDX_NAMES) {
+		c->full = true;
+		return 1;
+	}
+	n = &fidx.n[fidx.count++];
+	n->parent = c->parent;
+	n->name = fidx.names_used;
+	n->first = e->first;
+	n->size = e->dir ? 0 : e->size;
+	n->dir = e->dir;
+	n->ram = NULL;
+	memcpy(fidx.names + fidx.names_used, name, l);
+	fidx.names_used += l;
+	return 0;
+}
+
+static void
+idx_free(void)
+{
+	if (fidx.n) {
+		kfree_data(fidx.n, IDX_MAX_NODES * sizeof(struct mfw_node));
+	}
+	if (fidx.names) {
+		kfree_data(fidx.names, IDX_NAMES);
+	}
+	bzero(&fidx, sizeof(fidx));
+}
+
+int
+mfw_index(void)
+{
+	if (fidx.built) {
+		return 0;
+	}
+	if (!fat.mounted) {
+		return ENXIO;
+	}
+	fidx.n = kalloc_data(IDX_MAX_NODES * sizeof(struct mfw_node), Z_WAITOK | Z_ZERO);
+	fidx.names = kalloc_data(IDX_NAMES, Z_WAITOK | Z_ZERO);
+	if (!fidx.n || !fidx.names) {
+		idx_free();
+		return ENOMEM;
+	}
+	fidx.n[0].dir = true;                    /* the root; its name is "" at offset 0 */
+	fidx.names_used = 1;
+	fidx.count = 1;
+	/* breadth first with the node array as the queue: walks never nest (they share fat.dirbuf) */
+	for (uint32_t i = 0; i < fidx.count; i++) {
+		struct idx_ctx c = { i, false };
+		int rc;
+
+		if (!fidx.n[i].dir || (i != 0 && fidx.n[i].first < 2)) {
+			continue;                       /* a file, or an empty directory */
+		}
+		rc = mfw_walk(i == 0 ? 0 : fidx.n[i].first, idx_cb, &c);
+		if (c.full) {
+			MLOG("step W6 index: more than %u entries or %u name bytes; index not used", IDX_MAX_NODES, IDX_NAMES);
+			idx_free();
+			return ENOSPC;
+		}
+		if (rc > 1) {
+			idx_free();
+			return rc & 0xffff;
+		}
+	}
+	fidx.built = true;
+	return 0;
+}
+
+uint32_t
+mfw_index_entries(void)
+{
+	return fidx.built ? fidx.count - 1 : 0;
+}
+
+static int
+idx_lookup(const char *path, uint32_t *out)
+{
+	uint32_t cur = 0;
+	char comp[64];
+
+	while (*path == '/') {
+		path++;
+	}
+	while (*path) {
+		size_t n = 0;
+		uint32_t found = 0;
+
+		while (path[n] && path[n] != '/') {
+			n++;
+		}
+		if (n == 0 || n >= sizeof(comp) || !fidx.n[cur].dir) {
+			return ENOENT;
+		}
+		memcpy(comp, path, n);
+		comp[n] = 0;
+		/* first match in directory order, as the on-disk walk */
+		for (uint32_t i = 1; i < fidx.count; i++) {
+			if (fidx.n[i].parent == cur && name_eq(fidx.names + fidx.n[i].name, comp)) {
+				found = i;
+				break;
+			}
+		}
+		if (found == 0) {
+			return ENOENT;
+		}
+		cur = found;
+		path += n;
+		while (*path == '/') {
+			path++;
+		}
+	}
+	*out = cur;
+	return 0;
+}
+
+static bool
+idx_under(uint32_t i, uint32_t top)
+{
+	for (uint32_t hops = 0; hops < IDX_MAX_NODES; hops++) {
+		if (i == top) {
+			return true;
+		}
+		if (i == 0) {
+			return false;
+		}
+		i = fidx.n[i].parent;
+	}
+	return false;
+}
+
+int
+mfw_preload(const char *path, uint32_t *files, uint64_t *bytes)
+{
+	uint32_t top;
+	int error;
+
+	if (!fidx.built) {
+		return ENXIO;
+	}
+	if ((error = idx_lookup(path, &top)) != 0) {
+		return error;
+	}
+	for (uint32_t i = 1; i < fidx.count; i++) {
+		struct mfw_node *n = &fidx.n[i];
+		uint8_t *d;
+
+		if (n->dir || n->ram != NULL || !idx_under(i, top)) {
+			continue;
+		}
+		if (fidx.ram_bytes + n->size > PRELOAD_MAX) {
+			MLOG("step W6 preload: %s would pass %llu MB; stopped", fidx.names + n->name, PRELOAD_MAX >> 20);
+			return EFBIG;
+		}
+		if (n->size == 0) {
+			d = idx_empty;
+		} else {
+			struct mfw_file f = { .first = n->first, .size = n->size, .cur_idx = 0, .cur_cl = n->first, .ram = NULL };
+			d = kalloc_data(n->size, Z_WAITOK);
+			if (d == NULL) {
+				return ENOMEM;
+			}
+			if ((error = mfw_read(&f, 0, d, n->size)) != 0) {
+				MLOG("step W6 preload: reading %s (%u B) failed: %d", fidx.names + n->name, n->size, error);
+				kfree_data(d, n->size);
+				return error;
+			}
+		}
+		n->ram = d;
+		fidx.ram_bytes += n->size;
+		(*files)++;
+		*bytes += n->size;
+	}
+	return 0;
+}
+
