index 79ef585..bcad1ec 100644
--- a/bsd/dev/sweet_modem_fw.c
+++ b/bsd/dev/sweet_modem_fw.c
@@ -357,6 +357,222 @@ find_cb(void *ctx, const char *name, const struct mfw_ent *e)
