+/*
+ * 0179: one device-management UPIU in slot 0, no data (NOP OUT or QUERY REQUEST). The 0178 boot showed
+ * link startup resets the device (sense 6/29/00 on the first command after it), and then every LU
+ * answers 2/04/02 until the host sets fDeviceInit, as ufshcd_probe_hba does after every link startup:
+ * ufshcd_verify_dev_init (NOP OUT, 10 tries, 30 ms each, ufshcd.c:233-235) and ufshcd_complete_dev_init
+ * (SET FLAG fDeviceInit, then READ FLAG until the device clears it, 5 s, ufshcd.c:5728-5770).
+ * UPIU layout: vendor ufs.h:95-131,474-483 and include/uapi/scsi/ufs/ufs.h:9,90-91 (same commit as 0178);
+ * header bytes 0-3 = type, flags, LUN, tag; byte 5 = query function; bytes 12-15 = opcode, IDN, index,
+ * selector; response byte 6 = response code, value big-endian at bytes 20-23 (flag = bit 0 of byte 23).
+ * The UTRD is the one ufs_scsi builds (command type UFS storage, as ufshcd.c:3578-3580 for UFSHCI > 1.0).
+ */
+#define UPIU_NOP_OUT            0x00
+#define UPIU_NOP_IN             0x20
+#define UPIU_QUERY_REQ          0x16
+#define UPIU_QUERY_RSP          0x36
+#define QUERY_FN_READ           0x01
+#define QUERY_FN_WRITE          0x81
+#define QUERY_OP_READ_FLAG      0x05
+#define QUERY_OP_SET_FLAG       0x06
+#define FLAG_FDEVICEINIT        0x01
+
+static int
+ufs_devcmd(uint8_t type, uint8_t fn, uint8_t op, uint8_t idn, uint32_t timeout_ms, uint8_t *resp_type,
+    uint8_t *flag)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = type;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = fn;
+	ucd->cmd[12] = op;
+	ucd->cmd[13] = idn;
+	utrd->dw0 = (1u << 28) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_UTRLDBR, 1);
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime((uint64_t)timeout_ms * NSEC_PER_MSEC, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_retire();
+			return ETIMEDOUT;
+		}
+		delay(10);
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	dma_sync(DMA_UCD, sizeof(*ucd));
+	*resp_type = ucd->resp[0];
+	if (flag) {
+		*flag = ucd->resp[23] & 1;
+	}
+	if ((utrd->dw2 & 0xff) || ucd->resp[6]) {
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+ufs_device_init(void)
+{
+	uint8_t rt = 0, flag = 1;
+	int err = ETIMEDOUT;
+	unsigned i;
+
+	for (i = 0; i < 10 && err == ETIMEDOUT; i++) {
+		err = ufs_devcmd(UPIU_NOP_OUT, 0, 0, 0, 30, &rt, NULL);
+	}
+	if (err || rt != UPIU_NOP_IN) {
+		printf("SWEET UFS: restart: NOP OUT failed (%d, upiu 0x%x, %u tries)\n", err, rt, i);
+		return err ? err : EIO;
+	}
+	for (i = 0; i < 3 && (err = ufs_devcmd(UPIU_QUERY_REQ, QUERY_FN_WRITE, QUERY_OP_SET_FLAG,
+	    FLAG_FDEVICEINIT, 1500, &rt, NULL)); i++) {
+	}
+	if (err || rt != UPIU_QUERY_RSP) {
+		printf("SWEET UFS: restart: set fDeviceInit failed (%d, upiu 0x%x)\n", err, rt);
+		return err ? err : EIO;
+	}
+	uint64_t t0 = mach_absolute_time(), ns = 0;
+	do {
+		err = ufs_devcmd(UPIU_QUERY_REQ, QUERY_FN_READ, QUERY_OP_READ_FLAG, FLAG_FDEVICEINIT, 1500,
+		    &rt, &flag);
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (!err && flag) {
+			delay(1000);
+		}
+	} while ((err || flag) && ns < 5ull * NSEC_PER_SEC);
+	printf("SWEET UFS: restart: device init: NOP ok, fDeviceInit %s after %llu ms (err %d)\n",
+	    flag ? "STILL SET" : "cleared", ns / NSEC_PER_MSEC, err);
+	return (err || flag) ? (err ? err : ETIMEDOUT) : 0;
+}
