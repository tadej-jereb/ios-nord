From: lane 3 <lane3@ios-nord>
Subject: [PATCH] osmesa: the GPU's screen, and an IOSurface as a texture


OSMesa is the front end this port builds (no EGL). It gets the GPU's screen when there is
one, and glEGLImageTargetTexture2DOES takes an IOSurface ID as the image and imports it
through the winsys handle path (WINSYS_HANDLE_TYPE_FD, the ID as the handle) -- the memory is
the surface's, zero-copy, not a copy per frame.

The surface must be one plane of 'BGRA' with rows the GPU can address.

---
--- a/src/gallium/frontends/osmesa/osmesa.c
+++ b/src/gallium/frontends/osmesa/osmesa.c
@@ -86,7 +86,9 @@
 extern struct pipe_screen *
 osmesa_create_screen(void);
 
-
+/* an IOSurface, by its ID, as a texture (osmesa_target.c) */
+extern struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
 
 struct osmesa_buffer
 {
@@ -152,6 +154,30 @@
    }
 }
 
+/*
+ * There is no EGL here. What glEGLImageTargetTexture2DOES is handed as an image is the ID of an
+ * IOSurface, whose memory becomes the texture's where the driver can do that (Darwin).
+ */
+static bool
+osmesa_st_get_egl_image(struct pipe_frontend_screen *fscreen, void *image,
+                        struct st_egl_image *out)
+{
+   out->texture =
+      osmesa_surface_resource(fscreen->screen, (uint32_t)(uintptr_t)image);
+   if (!out->texture)
+      return false;
+   out->format = out->texture->format;
+   return true;
+}
+
+static bool
+osmesa_st_validate_egl_image(struct pipe_frontend_screen *fscreen, void *image)
+{
+   (void)fscreen;
+   (void)image;
+   return true;
+}
+
 static void
 create_st_manager(void)
 {
@@ -162,7 +188,8 @@
    if (global_fscreen) {
       global_fscreen->screen = osmesa_create_screen();
       global_fscreen->get_param = osmesa_st_get_param;
-      global_fscreen->get_egl_image = NULL;
+      global_fscreen->get_egl_image = osmesa_st_get_egl_image;
+      global_fscreen->validate_egl_image = osmesa_st_validate_egl_image;
    }
 }
 

--- a/src/gallium/targets/osmesa/meson.build
+++ b/src/gallium/targets/osmesa/meson.build
@@ -39,6 +39,7 @@
   ],
   dependencies : [
     dep_ws2_32, dep_thread, dep_clock, dep_unwind, driver_swrast, idep_mesautil,
+    driver_freedreno, idep_xmlconfig, dep_libdrm,
   ],
   name_prefix : host_machine.system() == 'windows' ? '' : [],  # otherwise mingw will create libosmesa.dll
   soversion : host_machine.system() == 'windows' ? '' : '8',

--- a/src/gallium/targets/osmesa/osmesa_target.c
+++ b/src/gallium/targets/osmesa/osmesa_target.c
@@ -26,10 +26,92 @@
 
 #include "sw/null/null_sw_winsys.h"
 
+#include "frontend/winsys_handle.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#ifdef GALLIUM_FREEDRENO
+#include "freedreno/drm/freedreno_drm_public.h"
+#include "util/driconf.h"
+#include "util/u_debug.h"
+#include "util/xmlconfig.h"
+#include <xf86drm.h>
+
+static int gpu_fd = -1;
+
+static const driOptionDescription freedreno_options[] = {
+#include "freedreno/driinfo_freedreno.h"
+};
+
+/* The GPU's driver, where the kernel has a GPU to drive (Darwin); NULL: there is none. */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, freedreno_options, ARRAY_SIZE(freedreno_options));
+   driParseConfigFiles(&cache, &info, 0, "msm", NULL, NULL, NULL, 0, NULL, 0);
+   config.options = &cache;
+   config.options_info = &info;
+   screen = fd_drm_screen_create_renderonly(fd, NULL, &config);
+   if (screen)
+      gpu_fd = fd;
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
 
 struct pipe_screen *
 osmesa_create_screen(void);
 
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The memory of an IOSurface as a texture to draw with and into (Darwin): the kernel's GPU
+ * driver makes a buffer of the surface, and the surface comes in as Linux's buffers come in, by
+ * a "descriptor" that is its ID. NULL: the screen is not the GPU's, or the surface is not one
+ * plane of 32-bit pixels, blue first, in rows the GPU can address.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+#ifdef GALLIUM_FREEDRENO
+   struct drm_msm_ios_surface s;
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD };
+
+   if (gpu_fd < 0 || drm_msm_ios_surface_info((int)surface, &s) != 0)
+      return NULL;
+   if (s.format != 0x42475241 /* 'BGRA' */ || s.pitch < s.width * 4u)
+      return NULL;
+   templ.width0 = s.width;
+   templ.height0 = s.height;
+   /* the kernel imports the surface's pages whole, from page 0: offset 0 */
+   handle.handle = surface;
+   handle.stride = s.pitch;
+   handle.offset = 0;
+   handle.size = s.size;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+#else
+   (void)screen;
+   (void)surface;
+   return NULL;
+#endif
+}
 
 struct pipe_screen *
 osmesa_create_screen(void)
@@ -37,6 +119,13 @@
    struct sw_winsys *winsys;
    struct pipe_screen *screen;
 
+#ifdef GALLIUM_FREEDRENO
+   /* the GPU if it is there, else software (OSMESA_SOFTWARE=true for software) */
+   screen = osmesa_create_gpu_screen();
+   if (screen)
+      return screen;
+#endif
+
    /* We use a null software winsys since we always just render to ordinary
     * driver resources.
     */
